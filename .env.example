# ProxCenter Docker Configuration
# Copy this file to .env and adjust values

# ========================================
# Required - Security Keys
# ========================================
# Generate with: openssl rand -base64 32
APP_SECRET=your-app-secret-change-me
NEXTAUTH_SECRET=your-nextauth-secret-change-me

# ========================================
# Required - Application URLs
# ========================================
# Public URL of your ProxCenter instance (used for redirects, callbacks)
NEXTAUTH_URL=https://proxcenter.example.com
APP_URL=https://proxcenter.example.com

# ========================================
# Optional - Session timeouts
# ========================================
# How long a browser session may live, in seconds. The database session row
# is authoritative — it is what actually revokes access — and the session
# cookie's own lifetime is derived from SESSION_ABSOLUTE_TIMEOUT so it can
# never outlive that row.
# SESSION_IDLE_TIMEOUT: time without activity before a session expires. Default: 43200 (12 hours)
# SESSION_ABSOLUTE_TIMEOUT: max session lifetime regardless of activity. Default: 604800 (7 days)
# SESSION_IDLE_TIMEOUT=43200
# SESSION_ABSOLUTE_TIMEOUT=604800

# Cloud image catalog (Automation > Templates). The built-in image list is also
# published as JSON in the public repo and re-fetched once a day, so new
# distribution releases show up without upgrading ProxCenter.
# TEMPLATE_CATALOG_URL: where to fetch it. Point it at an internal mirror of the
# same file on an air-gapped network.
# TEMPLATE_CATALOG_AUTO_UPDATE: set to "false" to disable the daily fetch. The
# "Check for updates" button on the catalog tab keeps working.
# TEMPLATE_CATALOG_URL=
# TEMPLATE_CATALOG_AUTO_UPDATE=true

# ========================================
# Optional - First-run setup secret
# ========================================
# POST /api/v1/auth/setup creates the first administrator and is reachable
# without authentication for as long as no account exists. That window is how
# a fresh install bootstraps, and it closes for good once one account exists.
# Set this on an instance whose first boot happens on a network someone else
# can reach: the setup request must then carry the same value in its
# x-setup-token header. Unset keeps the historical behaviour.
# PROXCENTER_SETUP_TOKEN=

# ========================================
# Database (Postgres)
# ========================================
# Postgres credentials for the bundled `postgres` compose service.
# In production these MUST be set to values you control. The defaults
# below are only suitable for local testing.
POSTGRES_USER=proxcenter
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=proxcenter

# Frontend connection string. The compose files build this same URL from
# the POSTGRES_* variables above and inject it as DATABASE_URL into the
# `proxcenter` service, so you usually don't need to set it explicitly.
# Override here if you point the frontend at an external Postgres.
# DATABASE_URL=postgresql://proxcenter:change-me-please@postgres:5432/proxcenter?schema=public

# ========================================
# Required for Enterprise edition - Orchestrator API key
# ========================================
# Shared secret used by the frontend to authenticate against the orchestrator
# REST API. Both services pick it up from this single variable
# (frontend: ORCHESTRATOR_API_KEY, orchestrator: PROXCENTER_API_API_KEY).
#
# Set it explicitly: with the post-migration startup order (frontend applies
# Prisma migrations before the orchestrator boots), the auto-generated key
# the orchestrator used to drop into a shared volume isn't readable in time.
# Generate with: openssl rand -hex 32
ORCHESTRATOR_API_KEY=your-orchestrator-api-key-change-me

# ========================================
# Optional - Enterprise: PDF report renderer (WeasyPrint)
# ========================================
# URL of the WeasyPrint sidecar used for Compliance > Frameworks PDF export.
# In the Enterprise compose stack this is pre-wired to http://weasyprint:5000.
# Only set this if you run WeasyPrint outside the bundled stack.
# PROXCENTER_REPORTING_URL=http://weasyprint:5000

# ========================================
# Optional - Instance identity
# ========================================
# Identity this frontend stamps on the migration jobs it runs, so a boot can
# fail the ones its own previous incarnation left behind instead of showing them
# as "In progress" forever. The single-node compose stacks already set it; leave
# it alone unless several frontends share one database, in which case every one
# of them needs its OWN value. Two instances sharing a value means a boot fails
# its live peers' migration jobs.
# PROXCENTER_INSTANCE_ID=proxcenter-frontend

# ========================================
# Optional - Enterprise: VDDK package for warm migration
# ========================================
# Broadcom closed the public VDDK download in August 2026, so the warm
# migration runtime ships as a private GHCR package and the product installs it
# on the target node. install-enterprise.sh already writes GHCR_TOKEN below;
# without it the "Prepare the node" action of the migrate dialog stays disabled.
# GHCR_TOKEN=
# Pin another package or tag than the shipped default:
# PROXCENTER_VDDK_PACKAGE=
# PROXCENTER_VDDK_TAG=

# ========================================
# Optional - Proxmox and migration budgets (milliseconds)
# ========================================
# PVE_TIMEOUT_MS: budget for a regular Proxmox API call. Default 8000.
# PVE_SLOW_READ_TIMEOUT_MS: budget for the reads that enumerate every storage,
# such as the migration Target Storage list. Default 30000. Raise it on a
# datacenter declaring many PBS targets.
# V2V_ROOT_CHOICE_TIMEOUT_MS: how long a cold migration waits for an operator
# to pick the root filesystem before releasing the node temp storage.
# Default 7200000, two hours.
# PVE_TIMEOUT_MS=8000
# PVE_SLOW_READ_TIMEOUT_MS=30000
# V2V_ROOT_CHOICE_TIMEOUT_MS=7200000

# ========================================
# Optional - Version pinning
# ========================================
# VERSION=latest
