# .env.ha.example
# Copy to .env and fill in all values. This file is used by docker-compose.ha.yml.

# ── Node identity ──────────────────────────────────────────────────
NODE_NAME=proxcenter-1
NODE_IP=10.0.0.11
VRRP_PRIORITY=150          # 150 / 100 / 50 for nodes 1 / 2 / 3

# ── Cluster peers ──────────────────────────────────────────────────
PEER1_IP=10.0.0.11
PEER2_IP=10.0.0.12
PEER3_IP=10.0.0.13
VIP=10.0.0.10
VIP_INTERFACE=eth0

# ── Application version ───────────────────────────────────────────
VERSION=latest

# ── Database ───────────────────────────────────────────────────────
POSTGRES_USER=proxcenter
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=proxcenter

# ── Secrets (identical on all 3 nodes) ────────────────────────
APP_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
ORCHESTRATOR_API_KEY=generate-with-openssl-rand-hex-32

# ── HA mode ────────────────────────────────────────────────────────
# These are set automatically in docker-compose.ha.yml frontend env.
# Do NOT set them manually unless you know what you're doing.
# HA_ENABLED=true             # Set in compose, not in .env
# HA_REDIRECT_DISABLED=true   # Break-glass: disable VIP redirect

# ── TLS (optional) ─────────────────────────────────────────────────
# ProxCenter listens on HTTP port 3000. TLS termination is the
# administrator's responsibility (reverse proxy in front of the VIP).
# If you add a reverse proxy, set TLS_CERT_PATH and TLS_KEY_PATH
# for your own proxy config; they are NOT used by docker-compose.ha.yml.
# TLS_CERT_PATH=/etc/ssl/proxcenter/fullchain.pem
# TLS_KEY_PATH=/etc/ssl/proxcenter/privkey.pem
