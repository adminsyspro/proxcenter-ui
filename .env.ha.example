# .env.ha.example
# Copy to .env and fill in all values. This file is used by docker-compose.ha.yml.
# The HA deploy wizard generates a complete .env automatically (preserving any
# existing keys); edit by hand only for manual deployments and recovery.

# ── Node identity ──────────────────────────────────────────────────
NODE_NAME=proxcenter-1
NODE_IP=10.0.0.11
VRRP_PRIORITY=150          # 150 / 100 / 50 for nodes 1 / 2 / 3

# ── Cluster peers ──────────────────────────────────────────────────
PEER1_IP=10.0.0.11
PEER2_IP=10.0.0.12
PEER3_IP=10.0.0.13
VIP=10.0.0.10
VIP_INTERFACE=eth0
VIP_PREFIX=24              # CIDR prefix length of the node subnet (the wizard derives it)

# ── Application version ───────────────────────────────────────────
VERSION=latest

# ── Registry access ────────────────────────────────────────────────
# Token used to pull the private ProxCenter images from ghcr.io on all 3
# nodes. The wizard reads it from node 1's .env and logs the other nodes in.
# GHCR_USERNAME=your-github-user
# GHCR_TOKEN=

# ── Database ───────────────────────────────────────────────────────
POSTGRES_USER=proxcenter
POSTGRES_PASSWORD=change-me-please
POSTGRES_DB=proxcenter
# PG_POOL_MAX=10           # frontend pg pool size per node (default 10)

# ── Secrets (identical on all 3 nodes) ────────────────────────
APP_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
ORCHESTRATOR_API_KEY=generate-with-openssl-rand-hex-32
# LICENSE_KEY=             # only for env-activated licenses

# ── External URL (FQDN / reverse-proxy / OIDC installs) ────────────
# Converted installs keep their original NEXTAUTH_URL (the wizard preserves
# it); fresh IP-only installs leave this unset and get http://<VIP>:3000.
# See docs/ha/reverse-proxy.md.
# NEXTAUTH_URL=https://proxcenter.example.com

# ── HA mode ────────────────────────────────────────────────────────
# HA_ENABLED=true                  # Set in compose, not in .env
# HA_REDIRECT_DISABLED=true        # Break-glass: disable the VIP redirect entirely
# HA_REDIRECT_EXEMPT_HOSTS=a.example.com,b.example.com
#                                  # Extra hostnames never VIP-redirected.
#                                  # NEXTAUTH_URL's host is always exempt.

# ── Timezone ───────────────────────────────────────────────────────
# TZ=Europe/Paris

# ── TLS (optional) ─────────────────────────────────────────────────
# ProxCenter listens on HTTP port 3000. TLS termination is the
# administrator's responsibility (reverse proxy in front of the VIP).
# See docs/ha/reverse-proxy.md.
