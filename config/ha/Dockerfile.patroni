# PostgreSQL stays on major 16: a major upgrade is a migration of the data
# directory, never a base image bump. The exact tag is moved by Dependabot.
FROM postgres:16.16-alpine3.24

# apk upgrade: the packages fixed in Alpine since the base image was built.
# gosu goes: the base image's own entrypoint is its only user, and this image
# starts Patroni through su-exec instead.
RUN apk upgrade --no-cache && \
    apk add --no-cache python3 py3-pip py3-psycopg2 su-exec gettext && \
    pip3 install --break-system-packages patroni[etcd3]==4.0.4 && \
    rm -f /usr/local/bin/gosu

COPY entrypoint-patroni.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
