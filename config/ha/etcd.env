# Reference: etcd is configured via environment variables in docker-compose.ha.yml.
# This file documents the full set for manual deployments outside compose.
# Hardened layout (security level 1): mutual TLS on the client and peer ports.

ETCD_NAME=${NODE_NAME}
ETCD_DATA_DIR=/var/lib/etcd
ETCD_LISTEN_PEER_URLS=https://${NODE_IP}:2380
ETCD_LISTEN_CLIENT_URLS=https://${NODE_IP}:2379
ETCD_INITIAL_ADVERTISE_PEER_URLS=https://${NODE_IP}:2380
ETCD_ADVERTISE_CLIENT_URLS=https://${NODE_IP}:2379
ETCD_INITIAL_CLUSTER=proxcenter-1=https://${PEER1_IP}:2380,proxcenter-2=https://${PEER2_IP}:2380,proxcenter-3=https://${PEER3_IP}:2380
ETCD_INITIAL_CLUSTER_STATE=new
ETCD_AUTO_COMPACTION_MODE=periodic
ETCD_AUTO_COMPACTION_RETENTION=1h
ETCD_CERT_FILE=/etc/etcd/tls/node.crt
ETCD_KEY_FILE=/etc/etcd/tls/node.key
ETCD_TRUSTED_CA_FILE=/etc/etcd/tls/ca.crt
ETCD_PEER_CERT_FILE=/etc/etcd/tls/node.crt
ETCD_PEER_KEY_FILE=/etc/etcd/tls/node.key
ETCD_PEER_TRUSTED_CA_FILE=/etc/etcd/tls/ca.crt
ETCD_CLIENT_CERT_AUTH=true
ETCD_PEER_CLIENT_CERT_AUTH=true
