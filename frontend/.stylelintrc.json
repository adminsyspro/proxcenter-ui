{
  "plugins": [
    "stylelint-plugin-logical-css"
  ],
  "overrides": [
    {
      "customSyntax": "postcss-styled-syntax",
      "files": [
        "**/*.{js,ts,jsx,tsx}"
      ]
    }
  ],
  "rules": {
    "logical-css/require-logical-properties": [
      true,
      {
        "ignore": [
          "overflow-x",
          "overflow-y"
        ]
      }
    ],
    "logical-css/require-logical-keywords": true
  }
}
