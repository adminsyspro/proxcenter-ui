        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "sum(proxcenter_vm_mem_bytes{connection=~\"$connection\",node=~\"$node\"})",
