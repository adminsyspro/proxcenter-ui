          "editorMode": "code",
          "expr": "sum(proxcenter_vm_mem_host_bytes{connection=~\"$connection\",node=~\"$node\"})",
          "range": true,
          "instant": false,
          "refId": "A",
          "legendFormat": "Host accounting"
