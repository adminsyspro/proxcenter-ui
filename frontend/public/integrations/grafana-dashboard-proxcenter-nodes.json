          "editorMode": "code",
          "expr": "sum(proxcenter_vm_mem_total_bytes{connection=~\"$connection\",node=~\"$node\"}) / sum(proxcenter_node_mem_total_bytes{connection=~\"$connection\",node=~\"$node\"})",
