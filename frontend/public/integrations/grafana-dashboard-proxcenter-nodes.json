            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.2
              }
            ]
          },
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "noValue": "No node reporting memory"
