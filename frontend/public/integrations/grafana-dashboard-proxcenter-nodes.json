      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS_PROMETHEUS}"
          },
          "editorMode": "code",
          "expr": "(proxcenter_node_mem_total_bytes{connection=~\"$connection\",node=~\"$node\"} - proxcenter_node_mem_bytes{connection=~\"$connection\",node=~\"$node\"}) / proxcenter_node_mem_total_bytes{connection=~\"$connection\",node=~\"$node\"}",
