          "405": {
            "description": "Method not allowed for this API token route",
            "content": {
              "application/json": {
                "example": {
                  "error": "Method not allowed for this API token route",
                  "method": "POST"
                }
              }
            }
          },
          "429": {
            "description": "Per-token quota exhausted",
            "content": {
              "application/json": {
