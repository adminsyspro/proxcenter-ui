  "paths": {
    "/api/v1/vms": {
      "get": {
        "operationId": "vms-list",
        "summary": "List all VMs and containers across visible connections",
        "description": "Aggregated VM/LXC list with status, usage and config-derived fields (cpuType, scsihw, agentEnabled, bios, ostype, onboot, description, macs) served by default. `ips` merges the addresses pinned in the config with the last known guest agent / LXC addresses from a background index; `staleIps` lists the last known addresses a guest could not re-confirm (stopped, agent down) and `ipIndexWarming` tells that the index is still being built. Pass include=agent to probe the QEMU guest agent on running VMs (about 7x slower).",
        "tags": [
          "Monitoring"
        ],
        "x-required-scopes": [
          "vms:read"
        ],
        "parameters": [
          {
            "name": "connId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Restrict to a single connection id"
          },
          {
            "name": "include",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Set to 'agent' to probe the guest agent on running VMs"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "headers": {
              "RateLimit-Limit": {
                "description": "Requests allowed per minute",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Remaining": {
                "description": "Requests left in the window",
                "schema": {
                  "type": "integer"
                }
              },
              "RateLimit-Reset": {
                "description": "Seconds until the window resets",
                "schema": {
                  "type": "integer"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "vms": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "properties": {
                              "id": {
                                "type": "string"
                              },
                              "connId": {
                                "type": "string"
                              },
                              "connectionName": {
                                "type": "string"
                              },
                              "node": {
                                "type": "string"
                              },
                              "vmid": {
                                "type": "string"
                              },
                              "name": {
                                "type": "string"
                              },
                              "type": {
                                "type": "string",
                                "enum": [
                                  "qemu",
                                  "lxc"
                                ]
                              },
                              "status": {
                                "type": "string"
                              },
                              "cpu": {
                                "type": "number"
                              },
                              "ram": {
                                "type": "number"
                              },
                              "cpuType": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "scsihw": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "agentEnabled": {
                                "type": "boolean"
                              },
                              "bios": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "ostype": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "onboot": {
                                "type": "boolean"
                              },
                              "description": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              },
                              "macs": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "ips": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "staleIps": {
                                "type": "array",
                                "items": {
                                  "type": "string"
                                }
                              },
                              "agentResponding": {
                                "type": "boolean"
                              },
                              "agentOsName": {
                                "type": [
                                  "string",
                                  "null"
                                ]
                              }
                            }
                          }
                        },
                        "stats": {
                          "type": "object",
                          "additionalProperties": {
                            "type": "number"
                          }
                        },
                        "ipIndexWarming": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unknown, invalid, revoked or expired token",
            "content": {
              "application/json": {
                "example": {
                  "error": "Invalid or expired API token"
                }
              }
            }
          },
          "403": {
            "description": "Token holds none of the required scopes",
            "content": {
              "application/json": {
                "example": {
                  "error": "Route not available to API tokens",
                  "route": "/api/v1/vms"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed for this API token route",
            "content": {
              "application/json": {
                "example": {
                  "error": "Method not allowed for this API token route",
                  "method": "POST"
                }
              }
            }
          },
          "429": {
            "description": "Per-token quota exhausted",
            "content": {
              "application/json": {
                "example": {
                  "error": "Rate limit exceeded",
                  "retryAfter": 42
                }
              }
            }
          }
        }
      }
    },
