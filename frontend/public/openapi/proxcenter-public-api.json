{
  "openapi": "3.1.0",
  "info": {
    "title": "ProxCenter public API",
    "version": "1",
    "description": "API for external tooling, authenticated by a pxc_ service-account token. Reading and writing depend on the scopes granted to the token. Write operations act on the real infrastructure immediately. Server to server: no CORS header is emitted."
  },
  "servers": [
    {
      "url": "{proxcenterBaseUrl}",
      "variables": {
        "proxcenterBaseUrl": {
          "default": "https://proxcenter.example.com"
        }
      }
    }
  ],
  "security": [
    {
      "bearerAuth": []
    }
  ],
  "tags": [
    {
      "name": "Monitoring"
    },
    {
      "name": "VMs"
    },
    {
      "name": "Snapshots"
    },
    {
      "name": "Backups"
    },
    {
      "name": "Storage"
    },
    {
      "name": "HA"
    },
    {
      "name": "Pools"
    },
    {
      "name": "Network"
    },
    {
      "name": "Firewall"
    },
    {
      "name": "Tasks"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Send the full secret as `Authorization: Bearer pxc_...`."
      }
    },
    "schemas": {
      "VmsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "vms": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "connId": {
                      "type": "string"
                    },
                    "connectionName": {
                      "type": "string"
                    },
                    "node": {
                      "type": "string"
                    },
                    "vmid": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "qemu",
                        "lxc"
                      ]
                    },
                    "status": {
                      "type": "string"
                    },
                    "cpu": {
                      "type": "number"
                    },
                    "ram": {
                      "type": "number"
                    },
                    "cpuType": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "scsihw": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "agentEnabled": {
                      "type": "boolean"
                    },
                    "bios": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ostype": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "onboot": {
                      "type": "boolean"
                    },
                    "description": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "macs": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "ips": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "staleIps": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "agentResponding": {
                      "type": "boolean"
                    },
                    "agentOsName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              },
              "stats": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              },
              "ipIndexWarming": {
                "type": "boolean"
              }
            }
          }
        }
      },
      "InventoryResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "clusters": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "pbsServers": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "externalHypervisors": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "cached": {
                "type": "boolean"
              },
              "stats": {
                "type": "object",
                "additionalProperties": {
                  "type": "number"
                }
              }
            }
          }
        }
      },
      "StorageResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "connections": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        }
      },
      "PbsBackupsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "PublicBackupsResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "guests": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "connId": {
                      "type": "string"
                    },
                    "connectionName": {
                      "type": "string"
                    },
                    "vmid": {
                      "type": "string"
                    },
                    "backupType": {
                      "type": "string",
                      "enum": [
                        "vm",
                        "ct",
                        "host"
                      ]
                    },
                    "latestBackupTime": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "latestBackupIso": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "ageSeconds": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "datastore": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "namespace": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pbsConnectionId": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "pbsConnectionName": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "sizeBytes": {
                      "type": [
                        "integer",
                        "null"
                      ]
                    },
                    "verified": {
                      "type": [
                        "boolean",
                        "null"
                      ]
                    }
                  }
                }
              },
              "warnings": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            }
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "data": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "ok",
                  "degraded"
                ]
              },
              "tenantId": {
                "type": "string"
              },
              "cached": {
                "type": "boolean"
              },
              "connections": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "connId": {
                      "type": "string"
                    },
                    "name": {
                      "type": "string"
                    },
                    "reachable": {
                      "type": "boolean"
                    },
                    "nodesOnline": {
                      "type": "integer"
                    },
                    "nodesTotal": {
                      "type": "integer"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "TaskStartedResponse": {
        "type": "object",
        "description": "A Proxmox task was started. `data` is its UPID; follow it with GET /api/v1/tasks/{connectionId}/{node}/{upid}.",
        "properties": {
          "data": {
            "type": "string",
            "description": "Proxmox task UPID"
          }
        }
      },
      "PrometheusExposition": {
        "type": "string",
        "description": "Prometheus text exposition format (version 0.0.4)."
      }
    },
    "x-scopes": {
      "vms:read": [
        "vm.view"
      ],
      "nodes:read": [
